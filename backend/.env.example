# Copy this file to .env and add your MongoDB Atlas connection string.

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/edutwin_ai?retryWrites=true&w=majority
DATABASE_NAME=edutwin_ai
JWT_SECRET_KEY=replace-with-a-long-random-secret
FRONTEND_ORIGIN=http://localhost:5173
GEMINI_API_KEY=replace-with-your-gemini-api-key





